{
  "name": "ux-starter-periskope",
  "version": "0.1.0",
  "private": true,
  "description": "Starter template for Netskope UX designers building AI prototypes with Claude Code",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "bootstrap": "./bootstrap.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "refresh-ds": "./scripts/vendor-ai-docs.sh && ./scripts/install-ds.sh && node scripts/generate-component-index.mjs",
    "generate-index": "node scripts/generate-component-index.mjs",
    "build-offline-snapshot": "./scripts/build-offline-snapshot.sh",
    "install-offline": "./scripts/install-ds.sh --offline",
    "deploy": "./scripts/deploy-local.sh"
  },
  "dependencies": {
    "@netskope-ui/charts": "latest",
    "@netskope-ui/combo-box": "latest",
    "@netskope-ui/core": "latest",
    "@netskope-ui/dates-v2": "latest",
    "@netskope-ui/dropdown": "latest",
    "@netskope-ui/file-uploader": "latest",
    "@netskope-ui/filter": "latest",
    "@netskope-ui/hooks": "latest",
    "@netskope-ui/icons": "latest",
    "@netskope-ui/pagination": "latest",
    "@netskope-ui/select": "latest",
    "@netskope-ui/side-panel-v2": "latest",
    "@netskope-ui/table-v2": "latest",
    "@netskope-ui/tabs": "latest",
    "@netskope-ui/tailwind": "latest",
    "@netskope-ui/toast-factory": "latest",
    "@netskope-ui/top-bar": "latest",
    "@netskope-ui/utils": "latest",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.0",
    "next": "^15.0.0",
    "prop-types": "^15.7.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
